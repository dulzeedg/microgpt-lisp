#lang racket
;; params to store the knowledge of the model

;; depth of the transformer neural network (number of layers)
(define n-layer 1)

;; width of the network
(define n-embd 16)

;; Block size
(define block-size 16)

;; number of attention heads
(define n-head 4)

;; dimension of each head
(define head-dim (quotient n-embd n-head))

;; helper functions
;; Generate normal(gaussian) random numbers
(define (normal-random mean std-dev)
  (let loop ()
    (let* ((u (* 2 (- (random ) 0.5)))
           (v (* 2 (- (random ) 0.5)))
           (s (+ (* u u) (* v v))))
      (if (or (= s 0) (>= s 1))
          (loop)
          (+ mean
             (* std-dev
                (* u
                   (sqrt (/ (* -2 (log s)) s)))))))))
;; Range
(define (iota n)
  (let loop ((i 0))
    (if (= i n)
        '()
        (cons i (loop (+ i 1))))))

(define matrix
  (lambda (nout nin std)
    (map (lambda (_)
           (map (lambda (_)
                  (make-value (normal-random 0 std)))
                (iota nin)))
         (iota nout))))

(define state-dict
  (append
    (list
      (cons 'wte
            (matrix vocab-size n-embd))
      (cons 'wpe
            (matrix block-size n-embd))
      (cons 'lm-head
            (matrix vocab-size n-embd)))

    (apply append
      (map
        (lambda (i)
          (list
            (cons
              (string->symbol (format "layer~a.attn_wq" i))
              (matrix n-embd n-embd))

            (cons
              (string->symbol (format "layer~a.attn_wk" i))
              (matrix n-embd n-embd))

            (cons
              (string->symbol (format "layer~a.attn_wv" i))
              (matrix n-embd n-embd))

            (cons
              (string->symbol (format "layer~a.attn_wo" i))
              (matrix n-embd n-embd))

            (cons
              (string->symbol (format "layer~a.mlp_fc1" i))
              (matrix (* 4 n-embd) n-embd))

            (cons
              (string->symbol (format "layer~a.mlp_fc2" i))
              (matrix n-embd (* 4 n-embd)))))
        
        (iota n-layer)))))

;; flatten deeply nested structure into a single list
(define (flatten x)
  (cond
    ((null? x) '())
    ((pair? x)
     (append (flatten (car x))
             (flatten (cdr x))))
    (else (list x))))

(define params
  (flatten (map cdr state-dict)))
  