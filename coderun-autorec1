#lang racket
;; block 1
(define names (list "abdul"))

;; read file line by line
(define (read-names filename)
  (let ((port (open-input-file filename)))
    (let loop ((lst '()))
      (let ((line (read-line port)))
        (if (eof-object? line)
            (begin (close-input-port port)
                   (reverse lst))
            (loop (cons (string-trim line) lst)))))))

(set! names (read-names "names.txt"))

(define uchars
  (list #\a #\b #\c #\d #\e #\f #\g
        #\h #\i #\j #\k #\l #\m
        #\n #\o #\p #\q #\r #\s
        #\t #\u #\v #\w #\x #\y #\z))

(define BOS (length uchars))
(define vocab-size (+ (length uchars) 1))

;; block 2
(define (make-value data)
  (vector data 0.0 '() '())) ; data, grad, children, local-grads

(define (value-data v) (vector-ref v 0))
(define (value-grad v) (vector-ref v 1))
(define (value-children v) (vector-ref v 2))
(define (value-local-grads v) (vector-ref v 3))

(define (set-value-data! v x) (vector-set! v 0 x))
(define (set-value-grad! v x) (vector-set! v 1 x))
(define (set-value-children! v xs) (vector-set! v 2 xs))
(define (set-value-local-grads! v xs) (vector-set! v 3 xs))

;; operations
(define (v+ a b)
  (let ((out (make-value (+ (value-data a) (value-data b)))))
    (set-value-children! out (list a b))
    (set-value-local-grads! out (list 1.0 1.0))
    out))

(define (v* a b)
  (let ((out (make-value (* (value-data a) (value-data b)))))
    (set-value-children! out (list a b))
    (set-value-local-grads! out (list (value-data b) (value-data a)))
    out))

(define (vpow a n)
  (let ((out (make-value (expt (value-data a) n))))
    (set-value-children! out (list a))
    (set-value-local-grads! out (list (* n (expt (value-data a) (- n 1)))))
    out))

(define (vlog a)
  (let* ((x (value-data a))
         (safe-x (max x 1e-12))
         (out (make-value (log safe-x))))
    (set-value-children! out (list a))
    (set-value-local-grads! out (list (/ 1.0 safe-x)))
    out))

(define (vexp a)
  (let* ((x (value-data a))
         (e (exp x))
         (out (make-value e)))
    (set-value-children! out (list a))
    (set-value-local-grads! out (list e))
    out))

(define (vneg a)
  (v* a (make-value -1.0)))

(define (v- a b)
  (v+ a (vneg b)))

(define (v/ a b)
  (v* a (vpow b -1)))

(define (vrelu a)
  (let* ((x (value-data a))
         (out (make-value (if (> x 0) x 0))))
    (set-value-children! out (list a))
    (set-value-local-grads! out (list (if (> x 0) 1.0 0.0)))
    out))

;; Topological sort
(define (contains? lst x)
  (cond ((null? lst) #f)
        ((eq? (car lst) x) #t)
        (else (contains? (cdr lst) x))))

(define (build-topo v visited topo)
  (if (contains? visited v)
      (cons visited topo)
      (let ((visited2 (cons v visited)))
        (let loop ((children (value-children v))
                   (vis visited2)
                   (tp topo))
          (if (null? children)
              (cons vis (cons v tp))
              (let* ((res (build-topo (car children) vis tp)))
                (loop (cdr children) (car res) (cdr res))))))))

;; Backpropagation
(define (backward loss)
  (let* ((res (build-topo loss '() '()))
         (topo (cdr res)))
    (set-value-grad! loss 1.0)
    (let loop ((lst topo))
      (unless (null? lst)
        (let* ((v (car lst))
               (grad (value-grad v))
               (children (value-children v))
               (locals (value-local-grads v)))
          (let rec ((cs children) (ls locals))
            (unless (null? cs)
              (let ((child (car cs))
                    (local-grad (car ls)))
                (set-value-grad! child (+ (value-grad child) (* local-grad grad)))
                (rec (cdr cs) (cdr ls))))))
        (loop (cdr lst))))))

;; block 3
;; depth of the transformer neural network (number of layers)
(define n-layer 1)

;; width of the network
(define n-embd 16)

;; Block size
(define block-size 16)

;; number of attention heads
(define n-head 4)

;; dimension of each head
(define head-dim (quotient n-embd n-head))

;; helper functions
;; normal random using Box-Muller
(define (normal-random mean std)
  (let loop ()
    (let* ((u (- (* 2 (random)) 1))
           (v (- (* 2 (random)) 1))
           (s (+ (* u u) (* v v))))
      (if (or (= s 0) (>= s 1))
          (loop)
          (+ mean (* std (* u (sqrt (/ (* -2 (log s)) s)))))))))
          
;; helper Range
(define (iota n)
  (if (= n 0)
      '()
      (cons 0 (map (lambda (x) (+ x 1)) (iota (- n 1))))))

;; matrix of Value objects
(define (matrix nout nin)
  (if (= nout 0)
      '()
      (cons (matrix-row nin) (matrix (- nout 1)))))

(define (matrix-row n)
  (if (= n 0)
      '()
      (cons (make-value (normal-random 0 0.08)) (matrix-row (- n 1)))))

(define state-dict
  (append
    (list
      (cons 'wte
            (matrix vocab-size n-embd))
      (cons 'wpe
            (matrix block-size n-embd))
      (cons 'lm-head
            (matrix vocab-size n-embd)))

    (apply append
      (map
        (lambda (i)
          (list
            (cons
              (string->symbol (format "layer~a.attn_wq" i))
              (matrix n-embd n-embd))

            (cons
              (string->symbol (format "layer~a.attn_wk" i))
              (matrix n-embd n-embd))

            (cons
              (string->symbol (format "layer~a.attn_wv" i))
              (matrix n-embd n-embd))

            (cons
              (string->symbol (format "layer~a.attn_wo" i))
              (matrix n-embd n-embd))

            (cons
              (string->symbol (format "layer~a.mlp_fc1" i))
              (matrix (* 4 n-embd) n-embd))

            (cons
              (string->symbol (format "layer~a.mlp_fc2" i))
              (matrix n-embd (* 4 n-embd)))))
        
        (iota n-layer)))))

;; flatten deeply nested structure into a single list
(define (flatten x)
  (cond
    ((null? x) '())
    ((pair? x)
     (append (flatten (car x))
             (flatten (cdr x))))
    (else (list x))))

(define params
  (flatten (map cdr state-dict)))
(define num-params (length params))
(newline)
(display num-params)


;; block 4
;; model architecture

;; computes linear transoformation
(define (dot a b)
  (foldl v+ (make-value 0.0)
         (map v* a b)))

(define (linear x w)
  (map (lambda (wo) (dot wo x)) w))

(define (softmax logits)
  (let* ((max-val (apply max (map value-data logits)))
         (exps (map (lambda (x)
                      (vexp (v- x (make-value max-val))))
                    logits))
         (sum-exps (foldl v+ (make-value 0.0) exps)))
    (map (lambda (x)
           (v/ x sum-exps))
         exps)))

(define (rmsnorm x)
  (let* ((ms (/ (apply + (map (lambda (xi) (* xi xi)) x))
                (length x)))
         (scale (/ 1 (sqrt (+ ms 1e-5)))))
    (map (lambda (xi) (* xi scale)) x)))

;; GPT forward pass
(define (gpt token-id pos-id keys values)
  
  ;; Embeddings: token + position
  (let* ((tok-emb (list-ref (cdr (assoc 'wte state-dict)) token-id))
         (pos-emb (list-ref (cdr (assoc 'wpe state-dict)) pos-id))
         (x (map v+ tok-emb pos-emb)))

    (define (rmsnorm xs) xs)
    (set! x (rmsnorm x))

    ;; Transformer layers
    (define (run-layer li x)
      (if (= li n-layer)
          x
          (let* (;; Multi-head Attention
                 (x-residual x)
                 (x-norm (rmsnorm x))
                 (q (linear x-norm (cdr (assoc
                                         (string->symbol (format "layer~a.attn_wq" li))
                                         state-dict))))
                 (k (linear x-norm (cdr (assoc
                                         (string->symbol (format "layer~a.attn_wk" li))
                                         state-dict))))
                 (v (linear x-norm (cdr (assoc
                                         (string->symbol (format "layer~a.attn_wv" li))
                                         state-dict)))))

            ;; update KV caches
            (vector-set! keys li (append (vector-ref keys li) (list k)))
            (vector-set! values li (append (vector-ref values li) (list v)))

            ;; Compute all attention heads recursively

            ;; helper 
            (define (slice xs start end)
              (take (drop xs start)
                    (- end start)))
            
            (define (run-head h acc)
              (if (= h n-head)
                  acc
                  (let* ((hs (* h head-dim))
                         (q-h (slice q hs (+ hs head-dim)))
                         (k-h (map (lambda (ki) (slice ki hs (+ hs head-dim)))
                                   (vector-ref keys li)))
                         (v-h (map (lambda (vi) (slice vi hs (+ hs head-dim)))
                                   (vector-ref values li)))
                         ;; attention logits
                         (attn-logits
                          (map (lambda (kh)
                                 (v/ (foldl v+ (map v* q-h kh))
                                     (make-value (sqrt head-dim))))
                               k-h))
                         (attn-weights (softmax attn-logits))
                         ;; weighted sum
                         (head-out
                          (map (lambda (j)
                                 (foldl v+ '()
                                        (map (lambda (t)
                                               (v* (list-ref attn-weights t)
                                                   (list-ref (list-ref v-h t) j)))
                                             (iota (length v-h)))))
                               (iota head-dim))))
                    (run-head (+ h 1) (append acc head-out)))))

            (let* ((x-attn (run-head 0 '()))
                   (x-attn-proj (linear x-attn (cdr (assoc (string->symbol (format "layer~a.attn_wo" li))
                                                           state-dict))))
                   (x1 (map v+ x-attn-proj x-residual))

                   ;; MLP block 
                   (x1-residual x1)
                   (x1-norm (rmsnorm x1))
                   (fc1 (linear x1-norm (cdr (assoc (string->symbol (format "layer~a.mlp_fc1" li))
                                                    state-dict))))
                   (act (map vrelu fc1))
                   (fc2 (linear act (cdr (assoc (string->symbol (format "layer~a.mlp_fc2" li))
                                                state-dict))))
                   (x2 (map v+ fc2 x1-residual)))

              ;; next layer
              (run-layer (+ li 1) x2)))))

    ;; run all layers
    (define x-final (run-layer 0 x))

    ;; final logits
    (linear x-final (cdr (assoc 'lm-head state-dict)))))

;; block 5
;; adam optimizer and buffers
(define learning-rate 0.01)
(define beta1 0.85)
(define beta2 0.99)
(define eps-adam 1e-8)

;; first moment buffer
(define m
  (make-vector num-params 0.0))

;; second moment buffer
(define v
  (make-vector num-params 0.0))

;; number of training steps
(define num-steps 1000)
;;helper
(define (list-index lst x)
  (let loop ((lst lst) (i 0))
    (cond
      ((null? lst) (error "not found"))
      ((equal? (car lst) x) i)
      (else (loop (cdr lst) (+ i 1))))))

(define (train step)
  (if (= step num-steps)
      'done
      (let* (

             ;; document
             (doc (list-ref names (modulo step (length names))))

             ;; tokens
             (tokens
              (append (list BOS)
                      (map (lambda (ch) (list-index uchars ch))
                           (string->list doc))
                      (list BOS)))

             ;; sequence length
             (n (min block-size (- (length tokens) 1)))

             ;; KV cache
             (keys (make-vector n-layer '()))
             (values (make-vector n-layer '()))

             ;; forward pass
             (losses
              (let loop ((pos 0) (acc '()))
                (if (= pos n)
                    acc
                    (let* ((token-id (list-ref tokens pos))
                           (target-id (list-ref tokens (+ pos 1)))

               ;; forward
               (logits (gpt token-id pos keys values))
               (probs (softmax logits))

               ;; loss (cross entropy)
               (loss-t (vneg (vlog (list-ref probs target-id)))))
                      (loop (+ pos 1)
                            (cons loss-t acc))))))
             ;; loss
             (loss
              (v* (make-value (/ 1 n))
                  (foldl v+ (make-value 0.0) losses))))

        ;; backward
        (backward loss)

        ;; optimizer
        (let loop ((i 0))
          (if (< i num-params)
              (let* ((p (list-ref params i))
                     (grad (value-grad p))

                     (m-new (+ (* beta1 (vector-ref m i))
                               (* (- 1 beta1) grad)))

                     (v-new (+ (* beta2 (vector-ref v i))
                               (* (- 1 beta2) (* grad grad))))

                     (m-hat (/ m-new (- 1 (expt beta1 (+ step 1)))))
                     (v-hat (/ v-new (- 1 (expt beta2 (+ step 1)))))

                     (update (/ m-hat (+ (sqrt v-hat) eps-adam))))

                (vector-set! m i m-new)
                (vector-set! v i v-new)

                (set-value-data!
                 p
                 (- (value-data p)
                    (* learning-rate update)))

                (set-value-grad! p 0.0)

                (loop (+ i 1)))
              'done))

        ;; log
        (displayln
         (format "step ~a / ~a | loss ~a"
                 (+ step 1)
                 num-steps
                 (value-data loss)))

        (train (+ step 1)))))
(train 0)