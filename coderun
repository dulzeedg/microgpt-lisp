;; flatten deeply nested structure into a single list
;; flatten params
(define params '())

(hash-for-each
 state-dict
 (lambda (k mat)
   (let loop1 ((i 0))
     (if (< i (vector-length mat))
         (begin
           (let ((row (vector-ref mat i)))
             (let loop2 ((j 0))
               (if (< j (vector-length row))
                   (begin
                     (set!
                      params
                      (cons
                       (vector-ref row j)
                       params))
                     (loop2 (+ j 1)))
                   'end)))
           (loop1 (+ i 1)))
         'end))))


;; block 4
;; model architecture
;; computes linear transoformation
(define (dot a b)
  (if (not (= (vector-length a) (vector-length b)))
      (error "dot size mismatch")
      (let loop ((i 0)
                 (acc (make-value 0.0)))
        (if (= i (vector-length a))
            acc
            (loop (+ i 1)
                  (v+ acc
                      (v* (vector-ref a i)
                          (vector-ref b i))))))))
;; linear layer
(define (linear x w)
  (let* ((nout (vector-length w))
         (out  (make-vector nout)))
    (let loop ((i 0))
      (if (< i nout)
          (begin
            (vector-set!
             out
             i
             (dot (vector-ref w i) x))
            (loop (+ i 1)))
          out))))

;; softmax
(define (softmax logits)
  (let ((max-val
         (value-data
          (vector-ref logits 0))))
    (let loop ((i 1))
      (if (< i (vector-length logits))
          (begin
            (set!
             max-val
             (max max-val
                  (value-data
                   (vector-ref logits i))))
            (loop (+ i 1)))
          'end))
    (let ((exps
           (make-vector
            (vector-length logits)))
          (sum-exps
           (make-value 0.0)))
      (let loop ((i 0))
        (if (< i(vector-length logits))
            (begin
              (let ((e
                     (vexp
                      (v-
                       (vector-ref logits i)
                       (make-value max-val)))))
                (vector-set! exps i e)
                (set!
                 sum-exps
                 (v+ sum-exps e)))
              (loop (+ i 1)))
            'end))
      (let ((out
             (make-vector
              (vector-length logits))))
        (let loop ((i 0))
          (if (< i (vector-length logits))
              (begin
                (vector-set!
                 out
                 i
                 (v/
                  (vector-ref exps i)
                  sum-exps))
                (loop (+ i 1)))
              out))))))

(define (rmsnorm x)
  (let ((ms
         (make-value 0.0)))
  (let loop ((i 0))
    (if (< i (vector-length x))
        (begin
          (set!
           ms
           (v+
            ms
            (v*
             (vector-ref x i)
             (vector-ref x i))))
          (loop (+ i 1)))
        'end))
  (set!
   ms
   (v/
    ms
    (make-value
     (vector-length x))))
  (let ((scale
         (vpow
          (v+
           ms
           (make-value 1e-5))
          -0.5)))
    (let ((out
           (make-vector
            (vector-length x))))
      (let loop ((i 0))
        (if (< i (vector-length x))
            (begin
              (vector-set!
               out
               i
               (v*
                (vector-ref x i)
                scale))
              (loop (+ i 1)))
            out))))))

;; GPT forward pass

(define (slice vec start end)
  (let* ((n (- end start))
         (out (make-vector n)))
    (let loop ((i 0))
      (if (< i n)
          (begin
            (vector-set!
             out
             i
             (vector-ref vec (+ start i)))
            (loop (+ i 1)))
          out))))

(define (gpt token-id pos-id keys values)
  
  ;; Embeddings:
  (let* ((tok-emb
          (vector-ref
           (hash-ref state-dict 'wte)
           token-id))
         
         (pos-emb
          (vector-ref
           (hash-ref state-dict 'wpe)
           pos-id))
         
         (x
          (make-vector n-embd)))

    ;; embedding sum
    (let loop ((i 0))
      (if (< i n-embd)
          (begin
            (vector-set!
             x
             i
             (v+
              (vector-ref tok-emb i)
              (vector-ref pos-emb i)))
            (loop (+ i 1)))
          'end))
    (set! x (rmsnorm x))

    ;; Transformer layers
    (let layer-loop ((li 0)
                     (x x))
      (if (= li n-layer)
          ;;final logits
          (linear
           x
           (hash-ref
            state-dict
            'lm-head))

          ;; transformer block
          (let* ((x-residual x)
                 (x-norm
                  (rmsnorm x))
                 (q
                  (linear
                   x-norm
                   (hash-ref
                    state-dict
                     (string->symbol
                      (string-append
                       "layer"
                       (number->string li)
                       ".attn_wq")))))
                  (k
                   (linear
                    x-norm
                    (hash-ref
                     state-dict
                     (string->symbol
                      (string-append
                       "layer"
                       (number->string li)
                       ".attn_wk")))))
                  (v
                   (linear
                    x-norm
                    (hash-ref
                     state-dict
                     (string->symbol
                      (string-append
                       "layer"
                       (number->string li)
                       ".attn_wv"))))))
                 ;;kv cache
                 (vector-set!
                  (vector-ref keys li)
                  pos-id
                  k)
                 (vector-set!
                  (vector-ref values li)
                  pos-id
                  v)
                 ;;attention output
                 (let ((x-attn
                        (make-vector n-embd)))
                   (let head-loop ((h 0))
                     (if (< h n-head)
                         (begin
                           (let* ((hs (* h head-dim))
                                  (q-h
                                   (slice q hs (+ hs head-dim)))
                                  (attn-logits
                                   (make-vector
                                    (+ pos-id 1))))
                             ;;logits
                             (let t-loop ((t 0))
                               (if (<= t pos-id)
                                   (begin
                                     (let* ((k-t
                                             (vector-ref
                                              (vector-ref keys li)
                                              t))
                                            (k-h
                                             (slice
                                              k-t
                                              hs
                                              (+ hs head-dim)))
                                            (score
                                             (let dot-loop
                                               ((j 0)
                                                (acc (make-value 0.0)))
                                               (if (= j head-dim)
                                                   (v/
                                                    acc
                                                    (make-value
                                                     (sqrt head-dim)))
                                                   (dot-loop
                                                    (+ j 1)
                                                    (v+
                                                     acc
                                                     (v*
                                                      (vector-ref q-h j)
                                                      (vector-ref k-h j))))))))
                                       (vector-set!
                                        attn-logits
                                        t
                                        score)
                                       (t-loop (+ t 1))))
                                   'end))
                             ;; weights
                             (let ((attn-weights
                                    (softmax attn-logits)))
                               ;;weighted sum
                               (let j-loop ((j 0))
                                 (if (< j head-dim)
                                     (begin
                                       (let sum-loop
                                         ((t 0)
                                          (acc (make-value 0.0)))
                                         (if (> t pos-id)
                                             (vector-set!
                                              x-attn
                                              (+ hs j)
                                              acc)
                                             (let* ((v-t
                                                     (vector-ref
                                                      (vector-ref values li)
                                                      t))
                                                    (v-h
                                                     (slice
                                                      v-t
                                                      hs
                                                      (+ hs head-dim))))
                                               (sum-loop
                                                (+ t 1)
                                                (v+
                                                 acc
                                                 (v*
                                                  (vector-ref attn-weights t)
                                                  (vector-ref v-h j)))))))
                                       (j-loop (+ j 1)))
                                     'end))))
                           (head-loop (+ h 1)))
                         'end))
                   ;;output projection
                   (let* ((x-proj
                           (linear
                            x-attn
                            (hash-ref
                             state-dict
                             (string->symbol
                              (string-append
                               "layer"
                               (number->string li)
                               ".attn_wo")))))
                          (x1
                           (make-vector n-embd)))
                     ;; residual
                     (let loop ((i 0))
                       (if (< i n-embd)
                           (begin
                             (vector-set!
                              x1
                              i
                              (v+
                               (vector-ref x-proj i)
                               (vector-ref x-residual i)))
                             (loop (+ i 1)))
                           'end))
                     ;; MLP
                     (let* ((x1-norm
                             (rmsnorm x1))
                            (fc1
                             (linear
                              x1-norm
                              (hash-ref
                               state-dict
                               (string->symbol
                                (string-append
                                 "layer"
                                 (number->string li)
                                 ".mlp_fc1")))))
                            (act
                             (make-vector
                              (* 4 n-embd))))
                       ;;relu
                       (let loop ((i 0))
                         (if (< i (* 4 n-embd))
                             (begin
                               (vector-set!
                                act
                                i
                                (vrelu
                                 (vector-ref fc1 i)))
                               (loop (+ i 1)))
                             'end))
                       (let* ((fc2
                               (linear
                                act
                                (hash-ref
                                 state-dict
                                 (string->symbol
                                  (string-append
                                   "layer"
                                   (number->string li)
                                   ".mlp_fc2")))))
                              (x2
                               (make-vector n-embd)))

                         ;;residual
                         (let loop ((i 0))
                                (if (< i n-embd)
                                    (begin
                                      (vector-set!
                                       x2
                                       i
                                       (v+
                                        (vector-ref fc2 i)
                                        (vector-ref x1 i)))
                                      (loop (+ i 1)))
                                    'end))
                              ;; next layer
                              (layer-loop (+ li 1)
                                          x2))))))))))

;; block 5
;; adam optimizer and buffers
(define learning-rate 0.01)
(define beta1 0.85)
(define beta2 0.99)
(define eps-adam 1e-8)

(set! params (list->vector (reverse params)))
(define num-params (vector-length params))

;; first moment buffer
(define m
  (make-vector num-params 0.0))

;; second moment buffer
(define v
  (make-vector num-params 0.0))

;; number of training steps
(define num-steps 1000)
;;helper
(define (vector-index vec x)
  (let loop ((i 0))
    (cond
      ((= i (vector-length vec))
       (error "not found"))
      ((equal? (vector-ref vec i) x)
       i)
      (else
       (loop (+ i 1))))))

(define (train step)
  (if (= step num-steps)
      'done
      (let* (
             ;; document
             (docs (list->vector names))
             (doc (vector-ref docs (modulo step (vector-length docs))))
             ;; tokens
             (token-list
              (append
               (list BOS)
               (map (lambda (ch)
                      (vector-index uchars ch))
                    (string->list doc))
               (list BOS)))
             (tokens
              (list->vector token-list))

             ;; sequence length
             (n (min block-size (- (vector-length tokens) 1)))

             ;; KV cache
             (keys (make-vector n-layer))
             (values (make-vector n-layer)))
        ;; initialize caches
        (let loop ((i 0))
          (if (< i n-layer)
              (begin
                (vector-set! keys i (make-vector block-size (make-value 0.0)))
                (vector-set! values i (make-vector block-size (make-value 0.0)))
                (loop (+ i 1)))
              'end))
        
        ;; forward pass
        (let ((losses '()))
          (let forward-loop ((pos 0))
            (if (< pos n)
                (begin
                  (let*
                      ((token-id
                        (vector-ref tokens pos))
                       (target-id
                        (vector-ref tokens (+ pos 1)))
                       (logits
                        (gpt
                         token-id
                         pos
                         keys
                         values))
                       (probs
                        (softmax logits))
                       
                       ;; loss (cross entropy)
                       (loss-t (vneg (vlog (vector-ref probs target-id)))))
                    
                    (set! losses
                     (cons loss-t losses))
                    (forward-loop (+ pos 1)))
                  )
                'done))
          
          (let*
                ((loss
                  (v*
                   (make-value (/ 1 n))
                   (foldl v+ (make-value 0.0) losses))))
              ;; backward
              (zero-grads loss)
            (reset-graph loss '())
              (backward loss)

              ;; adam optimizer
              (let loop ((i 0))
                (if (< i num-params)
                    (let* ((p (vector-ref params i))
                           (grad (value-grad p))
                           
                            (m-new (+ (* beta1 (vector-ref m i))
                                      (* (- 1 beta1) grad)))

                            (v-new (+ (* beta2 (vector-ref v i))
                                      (* (- 1 beta2) (* grad grad))))
                            
                            (m-hat (/ m-new (- 1 (expt beta1 (+ step 1)))))
                            (v-hat (/ v-new (- 1 (expt beta2 (+ step 1)))))

                            (update (/ m-hat (+ (sqrt v-hat) eps-adam))))
                      (vector-set! m i m-new)
                      (vector-set! v i v-new)
                      
                         (set-value-data!
                          p
                          (- (value-data p)
                             (* learning-rate update)))

                      (set-value-grad! p 0.0)                      
                      (loop (+ i 1)))
                    'done))
              ;; log
              (displayln
               (format "step ~a / ~a | loss ~a"
                       (+ step 1)
                       num-steps
                       (value-data loss)))
              (train (+ step 1))))
        )))
  (train 0)

;; block 6
;; inference
(define temperature 0.5)
(display "\n--- inference (new, hallucinated names) ---\n")

;; helper: weighted random choice
(define (weighted-random-choice weights)
  (let ((total 0.0))
    (let loop ((i 0))
      (if (< i (vector-length weights))
          (begin
            (set!
             total
             (+ total
                (vector-ref weights i)))
            (loop (+ i 1)))
          'done))
    (let ((r (* total (random 1.0))))
          (let loop ((i 0)
                     (acc 0.0))
            (if (= i (vector-length weights))
                (- (vector-length weights) 1)
                (let ((next
                       (+ acc
                          (vector-ref weights i))))
                  (if (< r next)
                      i
                      (loop (+ i 1)
                            next))))))))

;; helper: generate one sample recursively
(define (generate-sample pos-id token-id keys values acc)
  (if (= pos-id block-size)
      acc
      (let* ((logits (gpt token-id pos-id keys values))
             (scaled (make-vector (vector-length logits))))
        ;; divide temp
        (let loop ((i 0))
          (if (< i (vector-length logits))
              (begin
                (vector-set!
                 scaled
                 i
                 (v/
                  (vector-ref logits i)
                  (make-value temperature)))
                (loop (+ i 1)))
              'done))
        (let*
            ((probs
              (softmax scaled))
             (weights
            (make-vector
             (vector-length probs))))
          (let loop ((i 0))
            (if (< i (vector-length probs))
                (begin
                  (vector-set!
                   weights
                   i
                   (value-data
                    (vector-ref probs i)))
                  (loop (+ i 1)))
                'done))
          (let ((token-id-next
                 (weighted-random-choice
                  weights)))
            (if (= token-id-next BOS)
                acc
                (generate-sample
                 (+ pos-id 1)
                 token-id-next
                 keys
                 values
                 (cons
                  (vector-ref
                   uchars
                   token-id-next)
                  acc))))))))

;; helper: generate n samples recursively
(define (generate-n-samples sample-idx n)
  (if (= sample-idx n)
      'done
      (let ((keys (make-vector n-layer))
            (values (make-vector n-layer)))
        (let init ((i 0))
          (if (< i n-layer)
              (begin
                (vector-set!
                 keys i
                 (make-vector block-size (make-value 0.0)))
                (vector-set!
                 values i
                 (make-vector block-size (make-value 0.0)))
                (init (+ i 1)))
              'done))
        (let ((sample
               (reverse
                (generate-sample
                 0
                 BOS
                 keys
