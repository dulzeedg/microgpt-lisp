#lang racket

;; High level overview
;; text -> tokens -> embeddings -> transformer -> logits
;;      -> probabilities -> loss
;;      -> gradients -> parameter updates

;; after training
;; start token -> transformer -> next token
;;            -> append token
;;            -> repeat

;; block 1

(define names (list "abdul"))

;; read file line by line
(define (read-names filename)
  (let ((port (open-input-file filename)))
    (let loop ((lst '()))
      (let ((line (read-line port)))
        (if (eof-object? line)
            (begin (close-input-port port)
                   (reverse lst))
            (loop (cons (string-trim line) lst)))))))

(set! names (read-names "names.txt"))
;;(set! names (list->vector (read-names "names.txt")))
;; ("abdul" "john" "mary")

(define uchars
  (list->vector
   (sort
    (remove-duplicates
     (apply append
            (map string->list names))
     char=?)
    char<?)))

(define BOS (vector-length uchars))
;; "abdul" becomes
;; (BOS a b d u l BOS)
;; then numeric (17 0 1 2 14 8 17) this is what gpt do internally

(define vocab-size (+ BOS 1))

;; helper
(define (char->token ch)
  (let loop ((i 0))
    (cond ((= i (vector-length uchars))
           (error "char not found"))
          ((char=? (vector-ref uchars i) ch)
           i)
          (else
           (loop (+ i 1))))))

;; block 2
;; Autograd engine
(define (make-value data)
  (vector data 0.0 '() '()))

(define (value-data v) (vector-ref v 0))
(define (value-grad v) (vector-ref v 1))
(define (value-children v) (vector-ref v 2))
(define (value-local-grads v) (vector-ref v 3))

(define (set-value-data! v x) (vector-set! v 0 x))
(define (set-value-grad! v x) (vector-set! v 1 x))
(define (set-value-children! v xs) (vector-set! v 2 xs))
(define (set-value-local-grads! v xs) (vector-set! v 3 xs))
;; Value object becomes value = {
;;  data: actual numeric value
;;  grad: derivative accumulator
;; children: inputs that created this node
;;  local-grads: local derivatives
;; }

;; scalar operations
(define (v+ a b)
  (let ((out (make-value (+ (value-data a) (value-data b)))))
    (set-value-children! out (list a b))
    (set-value-local-grads! out (list 1.0 1.0))
    out))

(define (v* a b)
  (let ((out (make-value (* (value-data a) (value-data b)))))
    (set-value-children! out (list a b))
    (set-value-local-grads! out (list (value-data b) (value-data a)))
    out))

(define (vpow a n)
  (let ((out (make-value (expt (value-data a) n))))
    (set-value-children! out (list a))
    (set-value-local-grads! out (list (* n (expt (value-data a) (- n 1)))))
    out))

(define (vlog a)
  (let* ((x (value-data a))
         (safe-x (max x 1e-12))
         (out (make-value (log safe-x))))
    (set-value-children! out (list a))
    (set-value-local-grads! out (list (/ 1.0 safe-x)))
    out))

(define (vexp a)
  (let* ((x (value-data a))
         (e (exp x))
         (out (make-value e)))
    (set-value-children! out (list a))
    (set-value-local-grads! out (list e))
    out))

(define (vneg a)
  (v* a (make-value -1.0)))

(define (v- a b)
  (v+ a (vneg b)))

(define (v/ a b)
  (v* a (vpow b -1)))

(define (vrelu a)
  (let* ((x (value-data a))
         (out (make-value (if (> x 0) x 0))))
    (set-value-children! out (list a))
    (set-value-local-grads! out (list (if (> x 0) 1.0 0.0)))
    out))

;; Topological sort
(define (contains? lst x)
  (cond ((null? lst) #f)
        ((eq? (car lst) x) #t)
        (else (contains? (cdr lst) x))))

(define (build-topo v visited topo)
  (if (contains? visited v)
      (values visited topo)
      (let ((visited2 (cons v visited)))
        (let loop ((children (value-children v))
                   (vis visited2)
                   (tp topo))
          (if (null? children)
              (values vis (cons v tp))
              (let-values (((vis2 tp2)
                            (build-topo (car children) vis tp)))
                (loop (cdr children) vis2 tp2)))))))

;; Backpropagation
(define (zero-grads v)
  (set-value-grad! v 0.0)
  (for-each zero-grads (value-children v)))
(define (reset-graph v seen)
  (unless (contains? seen v)
    (set-value-grad! v 0.0)
    (for-each (lambda (c)
                (reset-graph c (cons v seen)))
              (value-children v))))

(define (backward loss)
  (let-values (((_ topo)
                (build-topo loss '() '())))
    
    (set-value-grad! loss 1.0)

    (let loop ((lst topo))
      (unless (null? lst)
        (let* ((v (car lst))
               (grad (value-grad v))
               (children (value-children v))
               (locals (value-local-grads v)))

          ;; propagate gradients
          (let rec ((cs children) (ls locals))
            (unless (null? cs)
              (let ((child (car cs))
                    (local-grad (car ls)))
                (set-value-grad!
                 child
                 (+ (value-grad child)
                    (* local-grad grad)))
                (rec (cdr cs) (cdr ls))))))

        (loop (cdr lst))))))

;; block 3
;; depth of the transformer neural network (number of layers)
;; hypeparams
(define n-layer 1)

;; width of the network
(define n-embd 16)

;; Block size
(define block-size 16)

;; number of attention heads
(define n-head 4)

;; dimension of each head
(define head-dim (quotient n-embd n-head))

;; helper functions
;; normal random using Box-Muller
(define (normal-random mean std)
  (let loop ()
    (let* ((u (- (* 2 (random)) 1))
           (v (- (* 2 (random)) 1))
           (s (+ (* u u) (* v v))))
      (if (or (= s 0) (>= s 1))
          (loop)
          (+ mean (* std (* u (sqrt (/ (* -2 (log s)) s)))))))))

;; matrix of Value objects
;; matrix helpers
(define (matrix-row n)
  (let ((row (make-vector n)))
    (let loop ((i 0))
      (if (< i n)
          (begin
            (vector-set!
             row
             i
             (make-value (normal-random 0 0.08)))
            (loop (+ i 1)))
          row))))
(define (matrix nout nin)
  (let ((m (make-vector nout)))
    (let loop ((i 0))
      (if (< i nout)
          (begin
            (vector-set! m i (matrix-row nin))
            (loop (+ i 1)))
          m))))

