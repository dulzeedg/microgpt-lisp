#lang racket

;; High level overview
;; text -> tokens -> embeddings -> transformer -> logits
;;      -> probabilities -> loss
;;      -> gradients -> parameter updates

;; after training
;; start token -> transformer -> next token
;;            -> append token
;;            -> repeat

;; block 1

(define names (list "abdul"))

;; read file line by line
(define (read-names filename)
  (let ((port (open-input-file filename)))
    (let loop ((lst '()))
      (let ((line (read-line port)))
        (if (eof-object? line)
            (begin (close-input-port port)
                   (reverse lst))
            (loop (cons (string-trim line) lst)))))))

(set! names (read-names "names.txt"))
;; ("abdul" "john" "mary")

(define uchars
  (list->vector
   (sort
    (remove-duplicates
     (apply append
            (map string->list names))
     char=?)
    char<?)))

(define BOS (vector-length uchars))
;; "abdul" becomes
;; (BOS a b d u l BOS)
;; then numeric (17 0 1 2 14 8 17) this is what gpt do internally

(define vocab-size (+ BOS 1))

;; helper
(define (char->token ch)
  (let loop ((i 0))
    (cond ((= i (vector-length uchars))
           (error "char not found"))
          ((char=? (vector-ref uchars i) ch)
           i)
          (else
           (loop (+ i 1))))))

;; block 2
;; Autograd engine
(define (make-value data)
  (vector data 0.0 '() '()))

(define (value-data v) (vector-ref v 0))
(define (value-grad v) (vector-ref v 1))
(define (value-children v) (vector-ref v 2))
(define (value-local-grads v) (vector-ref v 3))

(define (set-value-data! v x) (vector-set! v 0 x))
(define (set-value-grad! v x) (vector-set! v 1 x))
(define (set-value-children! v xs) (vector-set! v 2 xs))
(define (set-value-local-grads! v xs) (vector-set! v 3 xs))
;; Value object becomes value = {
;;  data: actual numeric value
;;  grad: derivative accumulator
;; children: inputs that created this node
;;  local-grads: local derivatives
;; }

;; scalar operations
(define (v+ a b)
  (let ((out (make-value (+ (value-data a) (value-data b)))))
    (set-value-children! out (list a b))
    (set-value-local-grads! out (list 1.0 1.0))
    out))

(define (v* a b)
  (let ((out (make-value (* (value-data a) (value-data b)))))
    (set-value-children! out (list a b))
    (set-value-local-grads! out (list (value-data b) (value-data a)))
    out))

(define (vpow a n)
  (let ((out (make-value (expt (value-data a) n))))
    (set-value-children! out (list a))
    (set-value-local-grads! out (list (* n (expt (value-data a) (- n 1)))))
    out))

(define (vlog a)
  (let* ((x (value-data a))
         (safe-x (max x 1e-12))
         (out (make-value (log safe-x))))
    (set-value-children! out (list a))
    (set-value-local-grads! out (list (/ 1.0 safe-x)))
    out))

(define (vexp a)
  (let* ((x (value-data a))
         (e (exp x))
         (out (make-value e)))
    (set-value-children! out (list a))
    (set-value-local-grads! out (list e))
    out))

(define (vneg a)
  (v* a (make-value -1.0)))

(define (v- a b)
  (v+ a (vneg b)))

(define (v/ a b)
  (v* a (vpow b -1)))

(define (vrelu a)
  (let* ((x (value-data a))
         (out (make-value (if (> x 0) x 0))))
    (set-value-children! out (list a))
    (set-value-local-grads! out (list (if (> x 0) 1.0 0.0)))
    out))

;; Topological sort
(define (contains? lst x)
  (cond ((null? lst) #f)
        ((eq? (car lst) x) #t)
        (else (contains? (cdr lst) x))))

(define (build-topo v visited topo)
  (if (contains? visited v)
      (cons visited topo)
      (let ((visited2 (cons v visited)))
        (let loop ((children (value-children v))
                   (vis visited2)
                   (tp topo))
          (if (null? children)
              (cons vis (cons v tp))
              (let* ((res (build-topo (car children) vis tp)))
                (loop (cdr children) (car res) (cdr res))))))))

;; Backpropagation
(define (backward loss)
  (let* ((res (build-topo loss '() '()))
         (topo (cdr res)))
    (set-value-grad! loss 1.0)
    (let loop ((lst topo))
      (unless (null? lst)
        (let* ((v (car lst))
               (grad (value-grad v))
               (children (value-children v))
               (locals (value-local-grads v)))
          (let rec ((cs children) (ls locals))
            (unless (null? cs)
              (let ((child (car cs))
                    (local-grad (car ls)))
                (set-value-grad! child (+ (value-grad child) (* local-grad grad)))
                (rec (cdr cs) (cdr ls))))))
        (loop (cdr lst))))))

;; block 3
;; depth of the transformer neural network (number of layers)
;; hypeparams
(define n-layer 1)

;; width of the network
(define n-embd 16)

;; Block size
(define block-size 16)

;; number of attention heads
(define n-head 4)

;; dimension of each head
(define head-dim (quotient n-embd n-head))

;; helper functions
;; normal random using Box-Muller
(define (normal-random mean std)
  (let loop ()
    (let* ((u (- (* 2 (random)) 1))
           (v (- (* 2 (random)) 1))
           (s (+ (* u u) (* v v))))
      (if (or (= s 0) (>= s 1))
          (loop)
          (+ mean (* std (* u (sqrt (/ (* -2 (log s)) s)))))))))

;; matrix of Value objects
;; matrix helpers
(define (matrix-row n)
  (let ((row (make-vector n)))
    (let loop ((i 0))
      (if (< i n)
          (begin
            (vector-set!
             row
             i
             (make-value (normal-random 0 0.08)))
            (loop (+ i 1)))
          row))))
(define (matrix nout nin)
  (let ((m (make-vector nout)))
    (let loop ((i 0))
      (if (< i nout)
          (begin
            (vector-set! m i (matrix-row nin))
            (loop (+ i 1)))
          m))))

;; state dict
(define state-dict
  (make-eq-hash-table))

(hash-table-set!
 state-dict
 'wte
 (matrix vocab-size n-embd))

(hash-table-set!
 state-dict
 'wpe
 (matrix block-size n-embd))

(hash-table-set!
 state-dict
 'lm-head
 (matrix vocab-size n-embd))

(let loop ((i 0))
  (if (< i n-layer)
      (begin
        (hash-table-set!
         state-dict       
         (string->symbol
          (string-append
           "layer"
           (number->string i)
           ".attn_wq"))
         (matrix n-embd n-embd))

        (hash-table-set!
         state-dict       
         (string->symbol
          (string-append
           "layer"
           (number->string i)
           ".attn_wk"))
         (matrix n-embd n-embd))

        (hash-table-set!
         state-dict       
         (string->symbol
          (string-append
           "layer"
           (number->string i)
           ".attn_wv"))
         (matrix n-embd n-embd))

        (hash-table-set!
         state-dict       
         (string->symbol
          (string-append
           "layer"
           (number->string i)
           ".attn_wo"))
         (matrix n-embd n-embd))

        (hash-table-set!
         state-dict       
         (string->symbol
          (string-append
           "layer"
           (number->string i)
           ".mlp_fc1"))
         (matrix (* 4 n-embd)
                 n-embd))

        (hash-table-set!
         state-dict       
         (string->symbol
          (string-append
           "layer"
           (number->string i)
           ".mlp_fc2"))
         (matrix n-embd
                 (* 4 n-embd)))

        (loop (+ i 1)))))
          
;; flatten deeply nested structure into a single list
;; flatten params
(define params '())

(hash-table-for-each
 state-dict
 (lambda (k mat)
   (let loop1 ((i 0))
     (if (< i (vector-length mat))
         (begin
           (let ((row (vector-ref mat i)))
             (let loop2 ((j 0))
               (if (< j (vector-length row))
                   (begin
                     (set!
                      params
                      (cons
                       (vector-ref row j)
                       params))
                     (loop2 (+ j 1))))))
           (loop1 (+ i 1)))))))


;; block 4
;; model architecture
;; computes linear transoformation
(define (dot a b)
  (let loop ((i 0)
             (acc (make-value 0.0)))
    (if (= i (vector-length a))
        acc
        (loop (+ i 1)
              (v+
               acc
               (v*
                (vector-ref a i)
                (vector-ref b i)))))))
;; linear layer
(define (linear x w)
  (let* ((nout (vector-length w))
         (out  (make-vector nout)))
    (let loop ((i 0))
      (if (< i nout)
          (begin
            (vector-set!
             out
             i
             (dot (vector-ref w i) x))
            (loop (+ i 1)))
          out))))

;; softmax
(define (softmax logits)
  (let ((max-val
         (value-data
          (vector-ref logits 0))))
    (let loop ((i 1))
      (if (< i (vector-length logits))
          (begin
            (set!
             max-val
             (max max-val
                  (value-data
                   (vector-ref logits i))))
            (loop (+ i 1)))))
    (let ((exps
           (make-vector
            (vector-length logits)))
          (sum-exps
           (make-value 0.0)))
      (let loop ((i 0))
        (if (< i(vector-length logits))
          (begin
            (let ((e
                   (vexp
                    (v-
                     (vector-ref logits i)
                     (make-value max-val)))))
              (vector-set! exps i e)
              (set!
               sum-exps
               (v+ sum-exps e)))
            (loop (+ i 1))))))
  (let ((out
         (make-vector
          (vector-length logits))))
    (let loop ((i 0))
      (if (< i (vector-length logits))
          (begin
            (vector-set!
             out
             i
             (v/
              (vector-ref exps i)
              sum-exps))
            (loop (+ i 1)))
          out))))

(define (rmsnorm x)
  (let ((ms
         (make-value 0.0)))
  (let loop ((i 0))
    (if (< i (vector-length x))
        (begin
          (set!
           ms
           (v+
            ms
            (v*
             (vector-ref x i)
             (vector-ref x i))))
          (loop (+ i 1)))))
  (set!
   ms
   (v/
    ms
    (make-value
     (vector-length x))))
  (let ((scale
         (vpow
          (v+
           ms
           (make-value 1e-5))
          -0.5)))
    (let ((out
           (make-vector
            (vector-length x))))
      (let loop ((i 0))
        (if (< i (vector-length x))
            (begin
              (vector-set!
               out
               i
               (v*
                (vector-ref x i)
                scale))
              (loop (+ i 1)))
            out))))))

;; GPT forward pass

(define (slice vec start end)
  (let* ((n (- end start))
         (out (make-vector n)))
    (let loop ((i 0))
      (if (< i n)
          (begin
            (vector-set!
             out
             i
             (vector-ref vec (+ start i)))
            (loop (+ i 1)))
          out))))

(define (gpt token-id pos-id keys values)
  
  ;; Embeddings:
  (let* ((tok-emb
          (vector-ref
           (hash-table-ref state-dict 'wte)
           token-id))
         
         (pos-emb
          (vector-ref
           (hash-table-ref state-dict 'wpe)
           pos-id))
         
         (x
          (make-vector n-embd)))

    ;; embedding sum
    (let loop ((i 0))
      (if (< i n-embd)
          (begin
            (vector-set!
             x
             i
             (v+
              (vector-ref tok-emb i)
              (vector-ref pos-emb i)))
            (loop (+ i 1)))))
    (set! x (rmsnorm x))

    ;; Transformer layers
    (let layer-loop ((li 0)
                     (x x))
      (if (= li n-layer)
          ;;final logits
          (linear
           x
           (hash-table-ref
            state-dict
            'lm-head))

          ;; transformer block
          (let* ((x-residual x)
                 (x-norm
                  (rmsnorm x))
                 (q
                  (linear
                   x-norm
                   (hash-table-ref
                    state-dict
                     (string->symbol
                      (string-append
                       "layer"
                       (number->string li)
                       ".attn_wq")))))
                  (k
                   (linear
                    x-norm
                    (hash-table-ref
                     state-dict
                     (string->symbol
                      (string-append
                       "layer"
                       (number->string li)
                       ".attn_wk")))))
                  (v
                   (linear
                    x-norm
                    (hash-table-ref
                     state-dict
                     (string->symbol
                      (string-append
                       "layer"
                       (number->string li)
                       ".attn_wv"))))))
                 ;;kv cache
                 (vector-set!
                  (vector-ref keys li)
                  pos-id
                  k)
                 (vector-set!
                  (vector-ref values li)
                  pos-id
                  v)
                 ;;attention output
                 (let ((x-attn
                        (make-vector n-embd)))
                   (let head-loop ((h 0))
                     (if (< h n-head)
                         (begin
                           (let* ((hs (* h head-dim))
                                  (q-h
                                   (slice q hs (+ hs head-dim)))
                                  (attn-logits
                                   (make-vector
                                    (+ pos-id 1))))
                             ;;logits
                             (let t-loop ((t 0))
                               (if (<= t pos-id)
                                   (begin
                                     (let* ((k-t
                                             (vector-ref
                                              (vector-ref keys li)
                                              t))
                                            (k-h
                                             (slice
                                              k-t
                                              hs
                                              (+ hs head-dim)))
                                            (score
                                             (let dot-loop
                                               ((j 0)
                                                (acc (make-value 0.0)))
                                               (if (= j head-dim)
                                                   (v/
                                                    acc
                                                    (make-value
                                                     (sqrt head-dim)))
                                                   (dot-loop
                                                    (+ j 1)
                                                    (v+
                                                     acc
                                                     (v*
                                                      (vector-ref q-h j)
                                                      (vector-ref k-h j))))))))
                                       (vector-set!
                                        attn-logits
                                        t
                                        score)
                                       (t-loop (+ t 1))))))
                             ;; weights
                             (let ((attn-weigths
                                    (softmax attn-logits)))
                               ;;weighted sum
                               (let j-loop ((j 0))
                                 (if (< j head-dim)
                                     (begin
                                       (let sum-loop
                                         ((t 0)
                                          (acc (make-value 0.0)))
                                         (if (> t pos-id)
                                             (vector-set!
                                              x-attn
                                              (+ hs j)
                                              acc)
                                             (let* ((v-t
                                                     (vector-ref
                                                      (vector-ref values li)
                                                      t))
                                                    (v-h
                                                     (slice
                                                      v-t
                                                      hs
                                                      (+ hs head-dim))))
                                               (sum-loop
                                                (+ t 1)
                                                (v+
                                                 acc
                                                 (v*
                                                  (vector-ref attn-weights t)
                                                  (vector-ref v-h j)))))))
                                       (j-loop (+ j 1)))))))
                           (head-loop (+ h 1)))))
                   ;;output projection
                   (let* ((x-proj
                           (linear
                            x-attn
                            (hash-table-ref
                             state-dict
                             (string->symbol
                              (string-append
                               "layer"
                               (number->string li)
                               ".attn_wo")))))
                          (x1
                           (make-vector n-embd)))
                     ;; residual
                     (let loop ((i 0))
                       (if (< i n-embd)
                           (begin
                             (vector-set!
                              x1
                              i
                              (v+
                               (vector-ref x-proj i)
                               (vector-ref x-residual i)))
                             (loop (+ i 1)))))
                     ;; MLP
                     (let* ((x1-norm
                             (rmsnorm x1))
                            (fc1
                             (linear
                              x1-norm
                              (hash-table-ref
                               state-dict
                               (string->symbol
                                (string-append
                                 "layer"
                                 (number->string li)
                                 ".mlp_fc1")))))
                            (act
                             (make-vector
                              (* 4 n-embd))))
                       ;;relu
                       (let loop ((i 0))
                         (if (< i (* 4 n-embd))
                             (begin
                               (vector-set!
                                act
                                i
                                (vrelu
                                 (vector-ref fc1 i)))
                               (loop (+ i 1)))))
                       (let* ((fc2
                               (linear
                                act
                                (hash-table-ref
                                 state-dict
                                 (string->symbol
                                  (string-append
                                   "layer"
                                   (number->string li)
                                   ".mlp_fc2")))))
                              ;;residual
                              (let loop ((i 0))
                                (if (< i n-embd)
                                    (begin
                                      (vector-set!
                                       x2
                                       i
                                       (v+
                                        (vector-ref fc2 i)
                                        (vector-ref x1 i)))
                                      (loop (+ i 1)))))
                              ;; next layer
                              (layer-loop (+ li 1)
                                          x2)))))))))))

;; block 5
;; adam optimizer and buffers
(define learning-rate 0.01)
(define beta1 0.85)
(define beta2 0.99)
(define eps-adam 1e-8)

;; first moment buffer
(define m
  (make-vector num-params 0.0))

;; second moment buffer
(define v
  (make-vector num-params 0.0))

;; number of training steps
(define num-steps 1000)
;;helper
(define (list-index lst x)
  (let loop ((lst lst) (i 0))
    (cond
      ((null? lst) (error "not found"))
      ((equal? (car lst) x) i)
      (else (loop (cdr lst) (+ i 1))))))

(define keys (make-vector n-layer))
(define values (make-vector n-layer))
(let loop ((i 0))
  (if (< i n-layer)
      (begin
        (vector-set! keys i (make-vector block-size))
        (vector-set! values i (make-vector block-size))
        (loop (+ i 1)))
      'end))

(define (train step)
  (if (= step num-steps)
      'done
      (let* (

             ;; document
             (doc (vector-ref names (modulo step (vector-length names))))

             ;; tokens
             (token-list
              (append
               (list BOS)
               (map (lambda (ch)
                      (list-index uchars ch))
                    (string->list doc))
               (list BOS)))
             (tokens
              (list->vector token-list))

             ;; sequence length
             (n (min block-size (- (vector-length tokens) 1)))

             ;; KV cache
             ;;(keys (make-vector n-layer '()))
             ;;(values (make-vector n-layer '()))

             ;; forward pass
             (losses
              (let loop ((pos 0) (acc '()))
                (if (= pos n)
                    acc
                    (let* ((token-id (vector-ref tokens pos))
                           (target-id (vector-length tokens))

               ;; forward
               (logits (gpt token-id pos keys values))
               (probs (softmax logits))

               ;; loss (cross entropy)
               (loss-t (vneg (vlog (vector-ref probs target-id)))))
                      (loop (+ pos 1)
                            (cons loss-t acc))))))
             ;; loss
             (loss
              (v* (make-value (/ 1 n))
                  (foldl v+ (make-value 0.0) losses))))

        ;; backward
        (backward loss)

        ;; optimizer
        (let loop ((i 0))
          (if (< i num-params)
              (let* ((p (vector-ref params i))
                     (grad (value-grad p))

                     (m-new (+ (* beta1 (vector-ref m i))
                               (* (- 1 beta1) grad)))

                     (v-new (+ (* beta2 (vector-ref v i))
                               (* (- 1 beta2) (* grad grad))))

                     (m-hat (/ m-new (- 1 (expt beta1 (+ step 1)))))
                     (v-hat (/ v-new (- 1 (expt beta2 (+ step 1)))))

                     (update (/ m-hat (+ (sqrt v-hat) eps-adam))))

                (vector-set! m i m-new)
                (vector-set! v i v-new)

                (set-value-data!
                 p
                 (- (value-data p)
                    (* learning-rate update)))

                (set-value-grad! p 0.0)

                (loop (+ i 1)))
              'done))

        ;; log
        (displayln
         (format "step ~a / ~a | loss ~a"
                 (+ step 1)
                 num-steps
                 (value-data loss)))

        (train (+ step 1)))))
(train 0)

;; block 6
;; inference
(define temperature 0.5)
(display "\n--- inference (new, hallucinated names) ---\n")

;; helper: weighted random choice
;; helper: weighted random choice
(define (weighted-random-choice weights)
  (let* ((total (apply + weights))
         (r (* total (random 1.0))))
    
    (let loop ((ws weights)
               (acc 0.0)
               (idx 0))

      (if (null? ws)
          (error "weighted-random-choice failed")

          (let ((w (car ws)))
            (if (< r (+ acc w))
                idx
                (loop (cdr ws)
                      (+ acc w)
                      (+ idx 1))))))))

;; helper: generate one sample recursively
(define (generate-sample pos-id token-id keys values acc)
  (if (= pos-id block-size)
      acc
      (let* ((logits (gpt token-id pos-id keys values))
             (scaled-logits (map (lambda (l) (v/ l (make-value temperature))) logits))
             (probs (softmax scaled-logits))
             (token-id-next (weighted-random-choice (map value-data probs))))
        (if (= token-id-next BOS)
            acc
            (generate-sample (+ pos-id 1) token-id-next keys values
                             (append acc (list (vector-ref uchars token-id-next))))))))

;; helper: generate n samples recursively
(define (generate-n-samples sample-idx n)
  (if (= sample-idx n)
      'done
      (let* ((keys (make-vector n-layer '()))
             (values (make-vector n-layer '()))
             (sample (generate-sample 0 BOS keys values '())))
        (display (format "sample ~a: ~a\n" (+ sample-idx 1) (apply string-append sample)))
        (generate-n-samples (+ sample-idx 1) n))))

;; generate 20 samples
(generate-n-samples 0 20)